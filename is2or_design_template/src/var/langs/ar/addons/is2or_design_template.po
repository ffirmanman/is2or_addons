msgctxt "SettingsTooltips::is2or_size_charts::show_in_product_page"
msgid "Select the location in product page to display size chart."
msgstr "اختر موقع العرض في صفحة المنتج لإظهار جدول المقاسات."

msgctxt "SettingsTooltips::is2or_size_charts::show_in_product_page_type"
msgid "In case you set a product page location you can select if the chart will be shown in the page or a link to show chart in popup."
msgstr "في حال قمت بتحديد موقع في صفحة المنتج، يمكنك اختيار ما إذا كان الجدول سيظهر مباشرة في الصفحة أو كرابط يفتح الجدول في نافذة منبثقة (Popup)."

msgctxt "SettingsTooltips::is2or_size_charts::show_in_table_mode_texts"
