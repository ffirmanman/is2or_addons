msgctxt "Languages::is2or_claid_ai.remove_background_tooltip"
msgid "Automatically removes the existing background, isolating the main subject for a clean and transparent result."
msgstr "يزيل الخلفية الحالية تلقائياً، ويعزل العنصر الأساسي للحصول على نتيجة نظيفة وشفافة."

msgctxt "Languages::is2or_claid_ai.enhance_image_tooltip"
msgid "Instantly improves image quality by automatically adjusting brightness, color balance, and sharpness."
msgstr "يحسن جودة الصورة فوراً عبر ضبط السطوع، وتوازن الألوان، والحدة تلقائياً."

msgctxt "Languages::is2or_claid_ai.generate_background_tooltip"
msgid "Creates a new AI-generated background based on your text prompt to create realistic product or lifestyle scenes."
msgstr "ينشئ خلفية جديدة بالذكاء الاصطناعي بناءً على وصفك النصي لإنشاء مشاهد واقعية للمنتجات."

