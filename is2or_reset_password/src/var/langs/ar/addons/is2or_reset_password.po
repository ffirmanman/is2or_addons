msgctxt "Languages::is2or_reset_password.page_title"
msgid "Reset Your Password"
msgstr "إعادة تعيين كلمة المرور الخاصة بك"

msgctxt "Languages::is2or_reset_password.page_description"
msgid "Please enter your new password below."
msgstr "يرجى إدخال كلمة المرور الجديدة أدناه."

msgctxt "Languages::is2or_reset_password.save_new_password"
msgid "Save New Password"
msgstr "حفظ كلمة المرور الجديدة"

msgctxt "Languages::is2or_reset_password.password_changed_login"
msgid "Your password has been changed successfully. Please log in with your new password."
msgstr "تم تغيير كلمة المرور الخاصة بك بنجاح. يرجى تسجيل الدخول باستخدام كلمة المرور الجديدة."

msgctxt "Languages::is2or_reset_password.password_change_failed"
msgid "An error occurred while changing your password. Please try again."
msgstr "حدث خطأ أثناء تغيير كلمة المرور الخاصة بك. يرجى المحاولة مرة أخرى."