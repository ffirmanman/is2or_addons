msgctxt "Languages::block_is2or_login_activity"
msgid "IS2OR: Login Activity"
msgstr "IS2OR: Login Activity"

msgctxt "Languages::block_is2or_login_activity_description"
msgid "Shows active login sessions for the current user with options to log out individual devices or all devices at once."
msgstr "Shows active login sessions for the current user with options to log out individual devices or all devices at once."

